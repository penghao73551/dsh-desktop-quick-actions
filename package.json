{
  "name": "dsh-desktop-quick-actions",
  "version": "1.1.0",
  "description": "Two round buttons at the DSH desktop sidebar foot: restart the app without a console window ever appearing, and open the DeepSeek top-up page in your browser.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop",
    "restart",
    "sidebar",
    "quick-actions"
  ],
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/client.js",
    "lib/relaunch.ps1",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
